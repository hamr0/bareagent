{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "strictNullChecks": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.js", "src/**/*.js", "tools/**/*.js", "bin/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "test"]
}
